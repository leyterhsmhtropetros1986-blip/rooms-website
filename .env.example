# Required by api/send-booking.js (the booking form's email API route).
# Set these as real values in Vercel: Project → Settings → Environment
# Variables, then redeploy. This file is just documentation — it has
# no effect on its own and is safe to commit (no real secrets).

# API key from your Resend account (https://resend.com)
RESEND_API_KEY=

# Sender address. The domain must be verified in Resend first
# (Resend dashboard → Domains), otherwise sending will fail.
BOOKING_FROM="Asteria Apartments <booking@asteriaapartments.gr>"

# Where booking requests should be delivered.
BOOKING_TO=info@asteriaapartments.gr
